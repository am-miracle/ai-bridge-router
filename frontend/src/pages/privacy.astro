---
export const prerender = true;

import MainLayout from "../layouts/main.astro";
import { LegalHeader } from "@/components/legal/LegalHeader";
import { LegalSection } from "@/components/legal/LegalSection";
import { privacyContent } from "@/config/privacy";

const content = {
  title: "Privacy Policy - Bridge Router",
  description:
    "Bridge Router's Privacy Policy. Learn how we collect, use, and protect your information when using our cross-chain bridge aggregator.",
  keywords:
    "privacy policy, data protection, user privacy, Bridge Router privacy, cryptocurrency privacy",
};
---

<MainLayout content={content}>
  <div class="max-w-4xl mx-auto space-y-12">
    <LegalHeader
      title={privacyContent.title}
      lastUpdated={privacyContent.lastUpdated}
      effectiveDate={privacyContent.effectiveDate}
      client:visible
    />

    <div class="space-y-8 py-8">
      {
        privacyContent.sections.map((section, index) => (
          <LegalSection section={section} index={index} client:visible />
        ))
      }
    </div>

    <!-- Quick Navigation -->
    <aside class="border-t border-border pt-8">
      <div class="p-6 rounded-lg bg-muted/50 space-y-4">
        <h3 class="font-semibold text-lg">Quick Navigation</h3>
        <ul class="space-y-2 text-sm">
          {
            privacyContent.sections.map((section) => {
              const sectionId = section.title
                .toLowerCase()
                .replace(/\s+/g, "-")
                .replace(/[^a-z0-9-]/g, "");
              return (
                <li>
                  <a
                    href={`#${sectionId}`}
                    class="text-muted-foreground hover:text-foreground transition-colors"
                  >
                    {section.title}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </aside>

    <!-- Contact Section -->
    <section class="border-t border-border pt-8">
      <div
        class="p-8 rounded-xl bg-gradient-to-br from-primary/5 to-primary/10 border border-primary/20 space-y-4"
      >
        <h3 class="text-xl font-bold">Questions About Privacy?</h3>
        <p class="text-muted-foreground">
          If you have any questions or concerns about our Privacy Policy, please don't hesitate to
          contact us.
        </p>
        <a
          href="mailto:judemiraco0@gmail.com?subject=Privacy%20Policy%20Inquiry"
          class="inline-block text-primary hover:underline font-medium"
        >
          judemiraco0@gmail.com
        </a>
      </div>
    </section>
  </div>
</MainLayout>
