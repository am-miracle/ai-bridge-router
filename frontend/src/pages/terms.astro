---
export const prerender = true;

import MainLayout from "../layouts/main.astro";
import { LegalHeader } from "@/components/legal/LegalHeader";
import { LegalSection } from "@/components/legal/LegalSection";
import { termsContent } from "@/config/terms";

const content = {
  title: "Terms of Service - Bridge Router",
  description:
    "Bridge Router's Terms of Service. Understand the terms and conditions for using our cross-chain bridge aggregator platform.",
  keywords:
    "terms of service, terms and conditions, user agreement, Bridge Router terms, legal terms",
};
---

<MainLayout content={content}>
  <div class="max-w-4xl mx-auto space-y-12">
    <LegalHeader
      title={termsContent.title}
      lastUpdated={termsContent.lastUpdated}
      effectiveDate={termsContent.effectiveDate}
      client:visible
    />

    <div class="space-y-8 py-8">
      {
        termsContent.sections.map((section, index) => (
          <LegalSection section={section} index={index} client:visible />
        ))
      }
    </div>

    <!-- Important Notice -->
    <aside class="border-t border-border pt-8">
      <div class="p-6 rounded-lg bg-yellow-500/10 border border-yellow-500/20 space-y-3">
        <h3 class="font-semibold text-lg flex items-center gap-2">
          <svg
            class="h-5 w-5 text-yellow-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            ></path>
          </svg>
          Important Notice
        </h3>
        <p class="text-sm text-muted-foreground">
          These Terms contain important information about your rights and obligations, including
          limitations on liability and dispute resolution provisions. Please read them carefully
          before using Bridge Router.
        </p>
      </div>
    </aside>

    <!-- Quick Navigation -->
    <aside class="border-t border-border pt-8">
      <div class="p-6 rounded-lg bg-muted/50 space-y-4">
        <h3 class="font-semibold text-lg">Quick Navigation</h3>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
          {
            termsContent.sections.map((section) => {
              const sectionId = section.title
                .toLowerCase()
                .replace(/\s+/g, "-")
                .replace(/[^a-z0-9-]/g, "");
              return (
                <li>
                  <a
                    href={`#${sectionId}`}
                    class="text-muted-foreground hover:text-foreground transition-colors"
                  >
                    {section.title}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </aside>

    <!-- Contact Section -->
    <section class="border-t border-border pt-8">
      <div
        class="p-8 rounded-xl bg-gradient-to-br from-primary/5 to-primary/10 border border-primary/20 space-y-4"
      >
        <h3 class="text-xl font-bold">Questions About These Terms?</h3>
        <p class="text-muted-foreground">
          If you have any questions or need clarification about our Terms of Service, please contact
          us.
        </p>
        <a
          href="mailto:judemiraco0@gmail.com?subject=Terms%20of%20Service%20Inquiry"
          class="inline-block text-primary hover:underline font-medium"
        >
          judemiraco0@gmail.com
        </a>
      </div>
    </section>
  </div>
</MainLayout>
